<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090F1D"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Top Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 1. Alarm Vector Icon (Clean SVG Vector, No Text Emoji) -->
    <ImageView
        android:id="@+id/iv_alarm_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="Alarm Icon"
        android:src="@drawable/ic_alarm_clock" />

    <!-- 2. Current Scheduled Time -->
    <TextView
        android:id="@+id/tv_alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="05:30 AM"
        android:textColor="#10B981"
        android:textSize="48sp"
        android:textStyle="bold" />

    <!-- 3. Alarm Title -->
    <TextView
        android:id="@+id/tv_alarm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="তাহাজ্জুদ সালাত"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Middle Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

    <!-- 4. Rounded Rectangle Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="vertical">

        <!-- Button 1: STOP (Solid Red Rounded Rectangle) -->
        <Button
            android:id="@+id/btn_alarm_dismiss"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_stop"
            android:drawableStart="@drawable/ic_stop"
            android:drawablePadding="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Button 2: SNOOZE (Dark Slate Rounded Rectangle) -->
        <Button
            android:id="@+id/btn_alarm_snooze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_snooze"
            android:drawableStart="@drawable/ic_snooze"
            android:drawablePadding="10dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="SNOOZE"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
