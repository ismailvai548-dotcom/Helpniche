# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token
ADMIN_CHAT_ID=your_admin_chat_id
TELEGRAM_BOT_USERNAME=your_bot_username

# REQUIRED by the telegram-webhook Supabase Edge Function: the Telegram numeric
# chat ID of the admin. When unset/empty, the webhook DENIES all admin
# approve/reject actions (fail-closed) instead of letting everyone through.
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Optional: when set, the telegram-webhook edge function only accepts requests
# carrying this exact value in the X-Telegram-Bot-Api-Secret-Token header
# (configure the same value as secret_token in BotFather's setWebhook call).
# Requests with a missing/wrong token are rejected with 401. Leave empty to
# disable the check (e.g. for local testing).
TELEGRAM_WEBHOOK_SECRET=generate_a_long_random_string

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Server Configuration
PORT=3000
